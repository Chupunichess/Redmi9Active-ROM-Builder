# Selected candidate for Xiaomi Redmi 9 Active (cattail).
# LineageOS 20 is based on Android 13.
ROM_NAME="LineageOS"
ROM_MANIFEST_URL="https://github.com/LineageOS/android.git"
ROM_BRANCH="lineage-20"
ANDROID_VERSION="13"

# The unified blossom product also supports the cattail hardware variant.
DEVICE_FAMILY="blossom"
DEVICE_VARIANT="cattail"
PRODUCT_NAME="lineage_blossom"
LUNCH_TARGET="lineage_blossom-userdebug"

# Source branch used by all device-specific projects below.
DEVICE_SOURCE_BRANCH="lineage-20"
